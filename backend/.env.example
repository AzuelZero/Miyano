# PostgreSQL connection string (required)
DATABASE_URL=postgres://miyano:dev@localhost:5432/miyano?sslmode=disable

# JWT signing secret (required, >= 32 chars — fail-fast on boot).
# Generate your own: the OLD example value ("change-me-…") is public and boot
# now REJECTS it. E.g.: openssl rand -hex 32
JWT_SECRET=generate-your-own-random-32plus-char-secret

# HTTP port (default 8080)
PORT=8080
